# MAG (Metagenome-Assembled Genomes) Workflow Container
#
# This definition file builds a container with all tools needed for the MAG workflow:
# - FastQC: Quality control
# - fastp: Read trimming
# - MEGAHIT: Metagenome assembly
# - SPAdes: Alternative assembler
# - QUAST: Assembly QC
# - Prodigal: Gene prediction
# - MetaBAT2: Genome binning
# - CheckM2: Bin quality assessment
# - GTDB-Tk: Taxonomic classification
# - Prokka: Genome annotation
# - MultiQC: Report aggregation
#
# Build: apptainer build MAG_Container.sif Apptainer/MAG_Container.def
# The resulting .sif is referenced directly via a file:// path — no registry push needed.

Bootstrap: docker
From: mambaorg/micromamba:1.5-jammy

%post
    # %post always runs as root during the build, so no USER switching is
    # needed (unlike the Dockerfile mambaorg pattern with USER root / $MAMBA_USER).

    # Install system dependencies
    # Added libgl1 and libfontconfig1 which are often required by QUAST's python dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        unzip \
        pigz \
        parallel \
        libgomp1 \
        procps \
        hmmer \
        xvfb \
        libgl1-mesa-glx \
        libfontconfig1
    rm -rf /var/lib/apt/lists/*

    # Combined Installation
    # This ensures the solver finds a version of Python and libraries (like matplotlib)
    # that work for QUAST, CheckM2, and Prokka simultaneously.
    micromamba install -y -n base -c conda-forge -c bioconda \
        python=3.8 \
        pandas \
        numpy \
        biopython \
        fastqc \
        fastp \
        multiqc \
        megahit \
        spades \
        quast \
        prodigal \
        metabat2 \
        samtools \
        bowtie2 \
        checkm2 \
        gtdbtk \
        prokka
    micromamba clean --all --yes

    # Copied in via %files below, before %post runs
    chmod +x /usr/local/bin/*.sh

    # Create directories
    mkdir -p /data /output /databases

%files
    bin/*.sh /usr/local/bin/

%environment
    # Ensure the micromamba bin is at the front of the PATH
    export PATH="/opt/conda/bin:$PATH"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # Run inside the activated micromamba 'base' environment
    exec micromamba run -n base "$@"

%labels
    maintainer Komal Thareja <kthare10@renci.org>
    description MAG Workflow - Metagenome Assembly, Binning, and Annotation
    version 1.1.0
