Bootstrap: docker
From: python:3.8.12-slim

%post
    # An unprivileged build maps one user and one group, so chown/chgrp return
    # "Invalid argument" and take the whole build down on a dpkg error that
    # names neither the cause nor the package.
    #
    # openssh-client is the one that bites here: its postinst runs
    #     chgrp ssh /usr/bin/ssh-agent && chmod 2755 /usr/bin/ssh-agent
    # but only when no statoverride is registered for that path. Registering
    # one first makes the postinst skip the step it cannot perform. Note the
    # absence of --update: that flag is what would apply the ownership now, and
    # applying it is exactly what fails.
    #
    # The trade is that ssh-agent is not setgid ssh, losing a ptrace-hardening
    # measure for the agent process. Recorded here rather than left implicit.
    # Use the same pattern for any other package whose postinst changes
    # ownership.
    dpkg-statoverride --add root root 0755 /usr/bin/ssh-agent

    # Install system dependencies
    apt-get update && \
        apt-get install -y git wget curl openssh-client build-essential
    rm -rf /var/lib/apt/lists/*

    # Install Python dependencies
    pip install --no-cache-dir \
        pandas \
        numpy \
        matplotlib \
        scipy \
        requests \
        scikit-learn \
        pytz

    # Create output directory
    mkdir -p /app/output

%environment
    # Set Python to not buffer output
    export PYTHONUNBUFFERED=1

%runscript
    exec /bin/bash "$@"

%labels
    maintainer Pegasus Workflow
